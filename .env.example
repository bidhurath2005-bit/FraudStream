# FraudStream configuration. Generate .env with random secrets: python scripts/new_env.py (see README.md §5.2).
# NEVER commit .env. All values below are placeholders.

# --- profile -------------------------------------------------------------------
FRAUDSTREAM_ENV=development            # development | test | production
FRAUDSTREAM_PROFILE=local              # local | distributed

# --- secrets (generate strong random values) -------------------------------------
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# --- local profile ---------------------------------------------------------------
# DATABASE_URL defaults to sqlite:///<repo>/data/fraudstream.db when unset (local profile only)

# --- distributed profile (host processes talking to docker compose services) ---------
# Use 127.0.0.1 (not 'localhost'): on Windows 'localhost' resolves to ::1 first and async
# Redis/PostgreSQL clients can stall until their connect timeout (verified in Phase 8).
# DATABASE_URL=postgresql+psycopg://fraudstream:<POSTGRES_PASSWORD>@127.0.0.1:5433/fraudstream
# REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6380/0
# KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
POSTGRES_DB=fraudstream
POSTGRES_USER=fraudstream
KAFKA_HOST_PORT=9092
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
FRAUDSTREAM_TOPIC_PREFIX=

# --- API -------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=1200
SECURE_COOKIES=false                   # set true behind HTTPS
MAX_UPLOAD_MB=200
FEATURE_WARM_START_HOURS=24

# --- container stack (docker compose --profile distributed | local) -------------------
# Login accounts created by the one-shot app-init container (random values via new_env.py).
FRAUDSTREAM_ADMIN_USERNAME=admin
FRAUDSTREAM_ADMIN_PASSWORD=change-me-Admin-1
FRAUDSTREAM_ANALYST_USERNAME=analyst
FRAUDSTREAM_ANALYST_PASSWORD=change-me-Analyst-1
FRONTEND_HOST_PORT=8080                # distributed dashboard: http://127.0.0.1:8080
FRONTEND_LOCAL_HOST_PORT=8081          # containerised LOCAL profile: http://127.0.0.1:8081
ARTIFACTS_MOUNT_MODE=ro                # ro protects ml/artifacts; rw enables training/activation from the API
