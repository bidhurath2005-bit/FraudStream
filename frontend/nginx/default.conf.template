# Rendered by the nginx image entrypoint (envsubst): only ${API_UPSTREAM} is substituted.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 210m;   # dataset uploads (API enforces MAX_UPLOAD_MB itself)

    # Docker's embedded DNS; resolving per request (via a variable) means a recreated API
    # container with a new IP is picked up without restarting nginx.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://${API_UPSTREAM};

    # X-Forwarded-For is SET to the connecting address, not appended to: nginx is the only entry point and the
    # API (uvicorn --forwarded-allow-ips *) takes the left-most entry as the client address, so an appended,
    # client-supplied value would let a client pick its own address (login rate-limit bypass, spoofed audit IPs).

    # (security headers are repeated per location: nginx drops inherited add_header when a
    #  location defines its own; API responses carry their own headers from FastAPI.)

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Live transaction feed (Server-Sent Events): no buffering, long-lived connection.
    location /api/v1/stream/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite: never forward a client-supplied value
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        add_header X-Accel-Buffering no;
    }

    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite: never forward a client-supplied value
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_connect_timeout 5s;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        try_files $uri $uri/ /index.html;
    }
}
